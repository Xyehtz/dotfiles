# NOTE: This file is copied to ~/.ssh/config

# GitHub account info
Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/GitHub
	AddKeysToAgent yes

# GitLab account info
Host gitlab.com
	HostName gitlab.com
	User git
	IdentityFile ~/.ssh/GitLab
	AddKeysToAgent yes

Host codeberg.org
	HostName codeberg.org
	User git
	IdentityFile ~/.ssh/Codeberg
	AddKeysToAgent yes
