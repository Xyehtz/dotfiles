# (Mac) Ghostty configuration is located on $HOME/Library/Application\ Support/com.mitchellh.ghostty/config.ghostty
# (Linux) ~/.config/ghostty/config.ghostty

# Shell used by Ghostty
# This alone was not enough, had to also add https://fishshell.com/docs/current/#default-shell
shell-integration = fish

# Appereance
theme = Rose Pine
mouse-hide-while-typing = true
background-opacity = 0.95

# Window
language = en

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s

# Behavior
auto-update = download
auto-update-channel = stable
copy-on-select = clipboard
shell-integration-features = true
quit-after-last-window-closed = true

# Keybinds
keybind = shift+alt+up=new_split:up
keybind = shift+alt+down=new_split:down
keybind = shift+alt+right=new_split:right
keybind = shift+alt+left=new_split:left
keybind = shift+alt+r=reload_config
keybind = shift+alt+c=close_surface

# Fonts
font-feature = feat=1
font-size = 11
font-family = "FiraCode Nerd Font"
freetype-load-flags = hinting,force-autohint

# Cursor
# Focused on custom cursor shaders to make the cursor look better on Ghostty
# The cursors are obtained from https://github.com/sahaj-b/cursor-shaders
# The Shaders are of extension .glsl, they are saved on the ./shaders folder
# The two options used are
#   custom-shader -> The path to the glsl file
#   custom-shader-animation -> Enable and set when the custom animation to run
#                              this can be True, False, or Always
#
custom-shader = ./shaders/cursor_wrap.glsl
custom-shader-animation = always
