# NOTE: This file is copied to ~/.ssh/config

# GitHub account info
Host personal-github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/GitHub
	AddKeysToAgent yes

# GitLab account info
Host gitlab.com
	HostName gitlab.com
	User git
	IdentityFile ~/.ssh/GitLab
	AddKeysToAgent yes

# Codeberg account information - Personal only
Host codeberg.org
	HostName codeberg.org
	User git
	IdentityFile ~/.ssh/Codeberg
	AddKeysToAgent yes

# School account for GitHub
Host sheridan-github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/Sheridan-Github
  AddkeysToAgent yes

# Network Switch
Host 192.168.71.50
  IdentitiesOnly yes
  IdentityFile ~/.ssh/Brocade-Switch
  KexAlgorithms +diffie-hellman-group1-sha1
  HostKeyAlgorithms=+ssh-rsa
  PubkeyAcceptedAlgorithms ssh-rsa
  Ciphers +aes128-cbc,3des-cbc
  MACs +hmac-sha1,hmac-md5
